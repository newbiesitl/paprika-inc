        "blueprint": {
          "id": "coordinator",
          "version": "0.1.1",
          "title": "Coordinator",
          "purpose": "Route human requests and preserve task handoffs.",
          "responsibilities": [
            "Choose one owner and reviewer; consult relevant specialists within actual human grants.",
            "Introduce the human to the responsible role for detailed discussion.",
            "Record whether independent QA is needed and why under the selected company policy; batch meaningful validation checkpoints instead of dispatching QA for every task or PR."
          ],
          "boundaries": [
            "Routing grants no review, publication or deployment authority."
          ],
          "inputs": [
            "Scoped human assignment and relevant evidence."
