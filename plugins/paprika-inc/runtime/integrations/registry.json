{
  "schema_version": 1,
  "adapters": {
    "agent-skills": {
      "description": "Reviewed SKILL.md procedures and selected resources packaged for native discovery.",
      "routes": [
        {
          "host": "codex-local",
          "mode": "native",
          "requires": [
            "plugin-skills"
          ]
        },
        {
          "host": "chatgpt",
          "mode": "native",
          "requires": [
            "plugin-skills"
          ]
        }
      ]
    },
    "claude-plugin": {
      "description": "Extract reusable skills and adapt provider-specific commands, agents and tool names.",
      "routes": [
        {
          "host": "codex-local",
          "mode": "adaptation-required",
          "requires": [
            "plugin-skills"
          ]
        },
        {
          "host": "chatgpt",
          "mode": "adaptation-required",
          "requires": [
            "plugin-skills"
          ]
        }
      ]
    },
    "role-markdown": {
      "description": "Map persona prose into Paprika role contracts and reusable workflow skills.",
      "routes": [
        {
          "host": "codex-local",
          "mode": "adaptation-required",
          "requires": [
            "plugin-skills"
          ]
        },
        {
          "host": "chatgpt",
          "mode": "adaptation-required",
          "requires": [
            "plugin-skills"
          ]
        }
      ]
    },
    "mcp-http": {
      "description": "Remote MCP service with separately observed host registration and authentication.",
      "routes": [
        {
          "host": "codex-local",
          "mode": "native",
          "requires": [
            "mcp-http"
          ]
        },
        {
          "host": "chatgpt",
          "mode": "native",
          "requires": [
            "mcp-http"
          ]
        }
      ]
    },
    "mcp-stdio": {
      "description": "Local MCP process; web ChatGPT requires a reachable hosted service.",
      "routes": [
        {
          "host": "codex-local",
          "mode": "native",
          "requires": [
            "mcp-stdio"
          ]
        },
        {
          "host": "chatgpt",
          "mode": "wrapper-required",
          "requires": [
            "mcp-http",
            "remote-worker"
          ]
        }
      ]
    },
    "python-library": {
      "description": "Typed domain operations over a Python library with a separately implemented worker.",
      "routes": [
        {
          "host": "codex-local",
          "mode": "wrapper-required",
          "requires": [
            "python-runtime",
            "local-process"
          ]
        },
        {
          "host": "chatgpt",
          "mode": "wrapper-required",
          "requires": [
            "mcp-http",
            "remote-worker"
          ]
        }
      ]
    },
    "rest-service": {
      "description": "Typed tools translate domain requests into an authenticated service API.",
      "routes": [
        {
          "host": "codex-local",
          "mode": "wrapper-required",
          "requires": [
            "mcp-http"
          ]
        },
        {
          "host": "chatgpt",
          "mode": "wrapper-required",
          "requires": [
            "mcp-http"
          ]
        }
      ]
    },
    "github-action": {
      "description": "Workflow execution and artifacts in GitHub with scoped dispatch and result tools.",
      "routes": [
        {
          "host": "github-ci",
          "mode": "native",
          "requires": [
            "actions-runner"
          ]
        },
        {
          "host": "codex-local",
          "mode": "wrapper-required",
          "requires": [
            "github-tools"
          ]
        },
        {
          "host": "chatgpt",
          "mode": "wrapper-required",
          "requires": [
            "github-tools"
          ]
        }
      ]
    }
  },
